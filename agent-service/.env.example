# ================================================================
# AgentHub Agent Service — 环境变量模板
# ================================================================
# 复制此文件为 .env 并填入你的真实 Key:
#   cp .env.example .env
# ================================================================

# ========== Claude Code API Key ==========
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ========== OpenAI / Codex API Key ==========
# 获取方式: https://platform.openai.com/api-keys
# 可选——仅在使用 Codex Agent 时需要
OPENAI_API_KEY=your-api-key-here

# ========== Codex CLI 配置（可选） ==========
# Codex 在非 Git 目录下需要跳过仓库检查
# CODEX_SKIP_GIT_CHECK=true

# ========== Agent CLI 自动批准参数 ==========
# Claude Code: --permission-mode bypassPermissions 跳过所有权限提示
# CLAUDE_CLI_ARGS=["--permission-mode", "bypassPermissions"]
# Codex: --full-auto 全自动模式，跳过所有确认
# CODEX_CLI_ARGS=["--full-auto"]

# ========== 工作空间根目录 ==========
# Agent 独立工作区根目录（必须在项目目录之外，实现文件系统级隔离）
# 默认: ~/agenthub_workspaces（用户主目录下）
# AGENT_WORKSPACE_ROOT=~/agenthub_workspaces
