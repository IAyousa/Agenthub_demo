# ================================================================
# AgentHub — Docker Compose 环境变量
# ================================================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.docker .env
# ================================================================

# ========== 必需：Claude Code API Key ==========
# 获取方式: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ========== 可选：OpenAI / Codex API Key ==========
# 仅在使用 Codex Agent 时需要
OPENAI_API_KEY=

# ========== JWT 签名密钥（生产环境务必修改）==========
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ========== CORS 允许的来源 ==========
# 部署后改为服务器的实际域名或 IP
# 多个来源用逗号分隔，如: http://example.com,https://example.com
CORS_ORIGINS=http://localhost

# ========== PostgreSQL 密码（仅 PG Profile 时使用）==========
PG_PASSWORD=agenthub123
