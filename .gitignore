# .gitignore
# 团队统一忽略文件

# ========== 依赖目录 ==========
node_modules/
frontend/node_modules/
target/
__pycache__/
*.pyc
.venv/
venv/
.m2

# ========== 环境变量 ==========
.env
.env.local
.env.*.local

# ========== IDE ==========
.idea/
.vscode/
*.swp
*.swo

# ========== 系统文件 ==========
.DS_Store
Thumbs.db

# ========== 产物存储目录 ==========
dist/
frontend/dist/
artifacts/
backend-java/artifacts/

# ========== 日志 ==========
*.log
logs/
*.log.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
hs_err_pid*

# ========== Docker ==========
postgres_data/
minio_data/
redis_data/
