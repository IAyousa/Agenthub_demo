# ================================================================
# AgentHub — 本地敏感配置模板
# ================================================================
# 复制此文件并命名为 application-secret.yml:
#   cp application-secret.yml.example application-secret.yml
#
# application-secret.yml 已被 .gitignore 忽略，不会提交到仓库。
# 该文件通过 spring.config.import 被 application.yml 自动加载。
#
# 生产环境建议通过环境变量注入（优先级高于此文件）：
#   JWT_SECRET  ← 覆盖 jwt.secret
#   PG_PASSWORD ← 覆盖 PostgreSQL 密码
# ================================================================

# JWT 认证（Spring Security + jjwt）
jwt:
  secret: agent-hub-dev-jwt-secret-key-for-jjwt-256bit             # 开发环境默认（≥32字符以满足jjwt HS256最低要求），生产请更换为 openssl rand -base64 32
  expiration: 86400000                           # Token 有效期（毫秒），默认 24 小时

# PostgreSQL（仅使用 pg profile 时需要）
# PG_USERNAME: agenthub
# PG_PASSWORD: agenthub123
